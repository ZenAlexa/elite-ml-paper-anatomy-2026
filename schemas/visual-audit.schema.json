{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZenAlexa/elite-ml-paper-anatomy-2026/schemas/visual-audit.schema.json",
  "title": "Per-paper figure and table audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "source_acquisition",
    "paper_style",
    "figures",
    "tables",
    "cross_object_system",
    "final_judgment"
  ],
  "properties": {
    "schema_version": {"const": "visual-audit.v1"},
    "paper_id": {"type": "string", "minLength": 1},
    "source_acquisition": {"$ref": "#/$defs/sourceAcquisition"},
    "paper_style": {"$ref": "#/$defs/paperStyle"},
    "figures": {
      "type": "array",
      "items": {"$ref": "#/$defs/figure"}
    },
    "tables": {
      "type": "array",
      "items": {"$ref": "#/$defs/table"}
    },
    "cross_object_system": {"$ref": "#/$defs/crossObjectSystem"},
    "final_judgment": {"$ref": "#/$defs/finalJudgment"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "visualPurpose": {
      "enum": [
        "headline",
        "method_interface",
        "theory_mechanism",
        "experimental_design",
        "main_comparison",
        "mechanism",
        "robustness",
        "efficiency_cost",
        "failure",
        "ablation",
        "qualitative_evidence",
        "reproduction",
        "dataset",
        "other"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "label", "basis"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "label": {"type": "string"},
        "bbox": {
          "type": ["array", "null"],
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "basis": {"enum": ["rendered_observation", "pdf_object", "source_exact"]}
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "path", "role", "tool", "evidence"],
      "properties": {
        "repository_url": {"type": "string"},
        "path": {"type": "string"},
        "role": {
          "enum": [
            "plot_script",
            "table_generator",
            "diagram_source",
            "paper_tex",
            "style_file",
            "data_file",
            "rendered_asset",
            "other"
          ]
        },
        "tool": {"type": ["string", "null"]},
        "evidence": {"type": "string"}
      }
    },
    "sourceAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repository_candidates", "selected_repository", "visual_source_files", "search_note"],
      "properties": {
        "status": {
          "enum": [
            "exact_visual_source",
            "partial_visual_source",
            "paper_source_only",
            "repository_without_visual_source",
            "no_public_source_found"
          ]
        },
        "repository_candidates": {
          "type": "array",
          "items": {"type": "string"}
        },
        "selected_repository": {"$ref": "#/$defs/nullableString"},
        "visual_source_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceFile"}
        },
        "search_note": {"type": "string"}
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "size_pt", "weight", "style", "provenance", "confidence"],
      "properties": {
        "family": {"type": "array", "items": {"type": "string"}},
        "size_pt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "median", "maximum"],
          "properties": {
            "minimum": {"type": ["number", "null"]},
            "median": {"type": ["number", "null"]},
            "maximum": {"type": ["number", "null"]}
          }
        },
        "weight": {"type": "array", "items": {"enum": ["regular", "medium", "semibold", "bold"]}},
        "style": {"type": "array", "items": {"enum": ["roman", "italic", "monospace", "small_caps"]}},
        "provenance": {"enum": ["source_exact", "pdf_object", "rendered_estimate", "mixed"]},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "color_count", "hex", "semantic_mapping", "redundant_encoding", "grayscale_safe", "provenance"],
      "properties": {
        "mode": {"enum": ["grayscale", "categorical", "sequential", "diverging", "mixed", "not_applicable"]},
        "color_count": {"type": "integer", "minimum": 0},
        "hex": {"type": "array", "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "semantic_mapping": {"type": "string"},
        "redundant_encoding": {"type": "boolean"},
        "grayscale_safe": {"type": "boolean"},
        "provenance": {"enum": ["source_exact", "rendered_estimate", "not_applicable"]}
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "panels", "series", "legend_items", "annotations", "data_marks_estimate"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "panels": {"type": "integer", "minimum": 1},
        "series": {"type": ["integer", "null"], "minimum": 0},
        "legend_items": {"type": ["integer", "null"], "minimum": 0},
        "annotations": {"type": ["integer", "null"], "minimum": 0},
        "data_marks_estimate": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "word_count", "moves", "headline_bold", "self_contained", "main_finding_stated"],
      "properties": {
        "text": {"type": "string"},
        "word_count": {"type": "integer", "minimum": 0},
        "moves": {
          "type": "array",
          "items": {
            "enum": [
              "title",
              "setup",
              "encoding_key",
              "comparison",
              "main_finding",
              "uncertainty_definition",
              "abbreviation_definition",
              "appendix_pointer"
            ]
          }
        },
        "headline_bold": {"type": "boolean"},
        "self_contained": {"type": "boolean"},
        "main_finding_stated": {"type": "boolean"}
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "page",
        "module",
        "placement",
        "width",
        "types",
        "purpose",
        "caption",
        "typography",
        "color",
        "complexity",
        "plot_grammar",
        "encodings",
        "data_and_statistics",
        "evidence_relation",
        "design_strengths",
        "design_weaknesses",
        "reusable_pattern",
        "evidence"
      ],
      "properties": {
        "label": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "module": {"type": "string"},
        "placement": {"enum": ["main", "appendix"]},
        "width": {"enum": ["single_column", "double_column", "page_width", "inset", "unknown"]},
        "types": {
          "type": "array",
          "items": {
            "enum": [
              "line",
              "bar",
              "scatter",
              "heatmap",
              "box",
              "violin",
              "area",
              "histogram",
              "matrix",
              "network",
              "tree",
              "pipeline",
              "architecture",
              "conceptual_diagram",
              "qualitative_grid",
              "image_montage",
              "screenshot",
              "map",
              "pareto",
              "other"
            ]
          }
        },
        "purpose": {
          "type": "array",
          "items": {"$ref": "#/$defs/visualPurpose"},
          "minItems": 1,
          "uniqueItems": true
        },
        "caption": {"$ref": "#/$defs/caption"},
        "typography": {"$ref": "#/$defs/typography"},
        "color": {"$ref": "#/$defs/color"},
        "complexity": {"$ref": "#/$defs/complexity"},
        "plot_grammar": {"$ref": "#/$defs/plotGrammar"},
        "encodings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "color", "shape", "line", "facet", "text"],
          "properties": {
            "x": {"$ref": "#/$defs/nullableString"},
            "y": {"$ref": "#/$defs/nullableString"},
            "color": {"$ref": "#/$defs/nullableString"},
            "shape": {"$ref": "#/$defs/nullableString"},
            "line": {"$ref": "#/$defs/nullableString"},
            "facet": {"$ref": "#/$defs/nullableString"},
            "text": {"$ref": "#/$defs/nullableString"}
          }
        },
        "data_and_statistics": {"type": "string"},
        "evidence_relation": {"type": "string"},
        "design_strengths": {"type": "array", "items": {"type": "string"}},
        "design_weaknesses": {"type": "array", "items": {"type": "string"}},
        "reusable_pattern": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "plotGrammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendering",
        "x_scale",
        "y_scale",
        "grid",
        "legend_present",
        "legend_placement",
        "shared_legend",
        "direct_labels",
        "marker_types",
        "line_styles",
        "hatching",
        "reference_lines",
        "uncertainty_display",
        "line_width_pt",
        "provenance"
      ],
      "properties": {
        "rendering": {"enum": ["vector", "raster", "mixed", "unknown"]},
        "x_scale": {"enum": ["linear", "log", "categorical", "time", "none", "unknown"]},
        "y_scale": {"enum": ["linear", "log", "categorical", "time", "none", "unknown"]},
        "grid": {"enum": ["none", "x", "y", "both", "unknown"]},
        "legend_present": {"type": "boolean"},
        "legend_placement": {"type": ["string", "null"]},
        "shared_legend": {"type": ["boolean", "null"]},
        "direct_labels": {"type": "boolean"},
        "marker_types": {"type": ["integer", "null"], "minimum": 0},
        "line_styles": {"type": ["integer", "null"], "minimum": 0},
        "hatching": {"type": "boolean"},
        "reference_lines": {"type": ["integer", "null"], "minimum": 0},
        "uncertainty_display": {
          "enum": ["none", "error_bar", "band", "ellipse", "box", "distribution", "multiple", "unknown"]
        },
        "line_width_pt": {"type": ["number", "null"], "minimum": 0},
        "provenance": {"enum": ["source_exact", "rendered_estimate", "mixed"]}
      }
    },
    "tableTypography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "body_size_pt", "header_size_pt", "header_weight", "provenance", "confidence"],
      "properties": {
        "family": {"type": "array", "items": {"type": "string"}},
        "body_size_pt": {"type": ["number", "null"]},
        "header_size_pt": {"type": ["number", "null"]},
        "header_weight": {"enum": ["regular", "medium", "semibold", "bold", "mixed"]},
        "provenance": {"enum": ["source_exact", "pdf_object", "rendered_estimate", "mixed"]},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "page",
        "module",
        "placement",
        "width",
        "purpose",
        "caption",
        "typography",
        "rows",
        "columns",
        "header_levels",
        "row_groups",
        "decimal_precision",
        "rules",
        "highlighting",
        "uncertainty",
        "data_and_statistics",
        "evidence_relation",
        "design_strengths",
        "design_weaknesses",
        "reusable_pattern",
        "evidence"
      ],
      "properties": {
        "label": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "module": {"type": "string"},
        "placement": {"enum": ["main", "appendix"]},
        "width": {"enum": ["single_column", "double_column", "page_width", "inset", "unknown"]},
        "purpose": {
          "type": "array",
          "items": {"$ref": "#/$defs/visualPurpose"},
          "minItems": 1,
          "uniqueItems": true
        },
        "caption": {"$ref": "#/$defs/caption"},
        "typography": {"$ref": "#/$defs/tableTypography"},
        "rows": {"type": ["integer", "null"], "minimum": 1},
        "columns": {"type": ["integer", "null"], "minimum": 1},
        "header_levels": {"type": ["integer", "null"], "minimum": 0},
        "row_groups": {"type": ["integer", "null"], "minimum": 0},
        "decimal_precision": {"type": ["integer", "null"], "minimum": 0},
        "rules": {"enum": ["booktabs", "grid", "partial_grid", "minimal", "none", "unknown"]},
        "highlighting": {"type": "array", "items": {"enum": ["bold", "underline", "italic", "arrows", "cell_color", "text_color", "best_second_best", "none"]}},
        "uncertainty": {"type": "string"},
        "data_and_statistics": {"type": "string"},
        "evidence_relation": {"type": "string"},
        "design_strengths": {"type": "array", "items": {"type": "string"}},
        "design_weaknesses": {"type": "array", "items": {"type": "string"}},
        "reusable_pattern": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "paperStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_figures",
        "main_tables",
        "appendix_figures",
        "appendix_tables",
        "dominant_figure_typography",
        "dominant_table_typography",
        "palette_strategy",
        "vector_raster_mix",
        "style_consistency"
      ],
      "properties": {
        "main_figures": {"type": "integer", "minimum": 0},
        "main_tables": {"type": "integer", "minimum": 0},
        "appendix_figures": {"type": "integer", "minimum": 0},
        "appendix_tables": {"type": "integer", "minimum": 0},
        "dominant_figure_typography": {"$ref": "#/$defs/typography"},
        "dominant_table_typography": {"$ref": "#/$defs/tableTypography"},
        "palette_strategy": {"type": "string"},
        "vector_raster_mix": {"type": "string"},
        "style_consistency": {"type": "string"}
      }
    },
    "crossObjectSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_narrative", "caption_system", "table_header_system", "method_result_ablation_link", "main_appendix_link", "typography_consistency", "color_consistency"],
      "properties": {
        "visual_narrative": {"type": "string"},
        "caption_system": {"type": "string"},
        "table_header_system": {"type": "string"},
        "method_result_ablation_link": {"type": "string"},
        "main_appendix_link": {"type": "string"},
        "typography_consistency": {"type": "string"},
        "color_consistency": {"type": "string"}
      }
    },
    "finalJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["most_reusable_patterns", "highest_value_objects", "failure_patterns", "one_sentence_visual_strategy"],
      "properties": {
        "most_reusable_patterns": {"type": "array", "items": {"type": "string"}},
        "highest_value_objects": {"type": "array", "items": {"type": "string"}},
        "failure_patterns": {"type": "array", "items": {"type": "string"}},
        "one_sentence_visual_strategy": {"type": "string"}
      }
    }
  }
}
